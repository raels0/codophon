{
  "name": "codophon",
  "version": "1.19.2",
  "private": true,
  "description": "Desktop code review for Git, GitHub, and Azure DevOps.",
  "license": "MIT",
  "author": "Ramee El",
  "contributors": [
    "Christoph Nakazawa"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/raels0/codophon.git"
  },
  "bin": {
    "codophon": "./bin/codophon.js"
  },
  "files": [
    "bin",
    "core",
    "dist",
    "electron",
    "skills"
  ],
  "type": "module",
  "main": "./electron/main.ts",
  "scripts": {
    "build": "vp build",
    "codophon": "node ./bin/codophon.js",
    "dev": "vp dev --host 127.0.0.1",
    "dev:app": "ELECTRON_RENDERER_URL=http://127.0.0.1:5173 node ./bin/codophon.js",
    "electron": "electron .",
    "forge:make": "electron-forge make",
    "forge:package": "electron-forge package",
    "link:global": "vp build && pnpm link --global",
    "make": "vpr build && electron-forge make",
    "make:ci": "vpr build && electron-forge make && electron-forge make --platform=win32",
    "make:mac": "vpr build && electron-forge make --platform=darwin --arch=arm64",
    "package:app": "vp build && electron-forge package",
    "prepack": "vp build",
    "prepare": "vp config",
    "test": "vp test",
    "test:e2e": "vp build && playwright test"
  },
  "dependencies": {
    "native-keymap": "^3.3.9"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@nkzw/eslint-plugin": "^2.0.0",
    "@nkzw/mdx-editor": "^1.0.4",
    "@nkzw/oxlint-config": "^2.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "@pierre/diffs": "1.6.4",
    "@pierre/trees": "1.0.0-beta.6",
    "@playwright/test": "^1.65.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "diff": "^9.0.0",
    "electron": "^45.2.1",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.66.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-hast": "^13.2.1",
    "mermaid": "^12.2.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "oxc-transform-react": "^0.156.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.21.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.16.1",
  "build": {
    "appId": "com.github.raels0.codophon",
    "copyright": "Copyright © 2026 Nakazawa Tech and Codophon contributors",
    "productName": "Codophon"
  }
}
