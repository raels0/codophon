{
  "name": "codiff",
  "version": "1.19.2",
  "private": true,
  "description": "A fast local diff viewer.",
  "license": "MIT",
  "author": {
    "name": "Christoph Nakazawa",
    "email": "christoph.pojer@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nkzw-tech/codiff.git"
  },
  "bin": {
    "codiff": "./bin/codiff.js"
  },
  "files": [
    "bin",
    "config",
    "core",
    "dist",
    "electron",
    "skills"
  ],
  "type": "module",
  "main": "./electron/main.cjs",
  "scripts": {
    "build": "vp build",
    "codiff": "node ./bin/codiff.js",
    "dev": "vp dev --host 127.0.0.1",
    "dev:app": "ELECTRON_RENDERER_URL=http://127.0.0.1:5173 node ./bin/codiff.js",
    "electron": "electron .",
    "eval:walkthrough": "node ./evals/run.mjs",
    "example:definition-navigation": "node ./examples/definition-navigation/run.mjs",
    "forge:make": "electron-forge make",
    "forge:package": "electron-forge package",
    "link:global": "vp build && pnpm link --global",
    "make": "vpr build && electron-forge make",
    "make:ci": "vpr build && electron-forge make && electron-forge package --platform=linux --arch=x64 && electron-forge make --platform=win32",
    "make:mac": "vpr build && electron-forge make --platform=darwin --arch=arm64",
    "package:app": "vp build && electron-forge package",
    "prepack": "vp build",
    "prepare": "vp config",
    "test": "vp test"
  },
  "dependencies": {
    "@nkzw/mdx-editor": "^1.0.4",
    "@nkzw/use-relative-time": "^1.2.3",
    "@phosphor-icons/react": "^2.1.10",
    "@pierre/diffs": "1.6.4",
    "@pierre/trees": "1.0.0-beta.6",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "diff": "^9.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.66.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-hast": "^13.2.1",
    "mermaid": "^12.2.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "native-keymap": "^3.3.9",
    "node-pty": "^1.1.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@nkzw/eslint-plugin": "^2.0.0",
    "@nkzw/oxlint-config": "^2.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "ghostty-web": "^0.4.0",
    "jsdom": "^30.1.3",
    "oxc-transform-react": "^0.156.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.21.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.16.1",
  "build": {
    "appId": "dev.nkzw-tech.codiff",
    "copyright": "Copyright © 2026-current Nakazawa Tech",
    "productName": "Codiff"
  }
}
