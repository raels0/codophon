#!/bin/sh
# The packaged `codophon` terminal helper. It runs the CLI (bin/codophon.js) with the app's bundled
# Electron runtime in Node mode, so the CLI works without a separate Node install. All argument
# handling lives in the CLI.
set -eu

source_path="$0"
while [ -L "$source_path" ]; do
  source_dir="$(CDPATH= cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
  linked_path="$(readlink "$source_path")"
  case "$linked_path" in
    /*) source_path="$linked_path" ;;
    *) source_path="$source_dir/$linked_path" ;;
  esac
done

script_dir="$(CDPATH= cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"

# macOS: <App>.app/Contents/Resources/app/bin -> <App>.app/Contents/MacOS/<executable>.
# Windows and Linux: the executable sits next to resources/, three levels above this script.
runtime="${CODOPHON_NODE_COMMAND:-}"
if [ -z "$runtime" ]; then
  for candidate in "$script_dir/../../../MacOS/"* "$script_dir/../../../codophon.exe" \
    "$script_dir/../../../codophon"; do
    if [ -f "$candidate" ] && [ -x "$candidate" ]; then
      runtime="$candidate"
      break
    fi
  done
fi
if [ -z "$runtime" ]; then
  printf '%s\n' "codophon: could not find the app's bundled runtime next to $script_dir." >&2
  exit 1
fi

ELECTRON_RUN_AS_NODE=1 exec "$runtime" "$script_dir/codophon.js" "$@"
